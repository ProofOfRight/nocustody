# SPDX-License-Identifier: Apache-2.0
# Copy to .env (chmod 600). Never commit the real file.

# Image to run, pinned by digest after `gh attestation verify` (docs/deployment.md).
NOCUSTODY_IMAGE=ghcr.io/proofofright/nocustody:0.2.1@sha256:REPLACE_WITH_VERIFIED_DIGEST

# Database password: letters and digits only (it is embedded in DATABASE_URL). `openssl rand -hex 32`
POSTGRES_PASSWORD=

# Checksum of the pinned addresses and contracts in config.json:
#   docker compose run --rm migrate config:hash
NOCUSTODY_PINNED_SHA256=

# Variables referenced from config.json by name (apiKeyEnv, secretEnv, botTokenEnv, ...), for example:
# TRONGRID_API_KEY=
# NOCUSTODY_WEBHOOK_SECRET=
# NOCUSTODY_TG_TOKEN=

LOG_LEVEL=info
