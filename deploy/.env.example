# SPDX-License-Identifier: Apache-2.0
# Copy to .env (chmod 600). Never commit the real file.

# Image to run, pinned by digest after `gh attestation verify` (docs/deployment.md).
NOCUSTODY_IMAGE=ghcr.io/proofofright/nocustody:0.6.0@sha256:REPLACE_WITH_VERIFIED_DIGEST

# Database passwords: letters and digits only (they are embedded in DATABASE_URL). `openssl rand -hex 32` each.
# POSTGRES_PASSWORD is the owner role (migrations, CLI); NOCUSTODY_DB_PASSWORD the gateway's runtime role.
POSTGRES_PASSWORD=
NOCUSTODY_DB_PASSWORD=

# Checksum of the pinned parts of config.json (addresses, contracts, providers, amount policies, pricing, AML, depeg,
# webhook URL; docs/adr/0031-pinned-config-scope.md). Recompute after any change to them:
#   docker compose run --rm --no-deps migrate config:hash
NOCUSTODY_PINNED_SHA256=

# Variables referenced from config.json by name (apiKeyEnv, secretEnv, botTokenEnv, ...), for example:
# TRONGRID_API_KEY=
# NOCUSTODY_WEBHOOK_SECRET=
# NOCUSTODY_TG_TOKEN=

LOG_LEVEL=info
