{
  "name": "nocustody",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted, non-custodial (watch-only) crypto payment gateway",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json",
    "layers": "depcruise src --config .dependency-cruiser.mjs",
    "licenses": "node scripts/check-licenses.ts",
    "source-policy": "node scripts/check-source.ts",
    "dco": "node scripts/check-dco.ts",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "check": "npm run lint && npm run typecheck && npm run layers && npm run licenses && npm run source-policy && npm test && npm run test:int",
    "e2e:nile": "node scripts/e2e-nile.ts",
    "e2e:ton": "node scripts/e2e-ton.ts",
    "e2e:api": "node scripts/e2e-api.ts",
    "e2e:ops": "node scripts/e2e-ops.ts",
    "db:migrate": "node src/app/cli.ts db:migrate",
    "build": "tsc -p tsconfig.build.json && cp -R src/adapters/persistence/pg/migrations dist/adapters/persistence/pg/"
  },
  "dependencies": {
    "@ton/core": "0.63.1",
    "@ton/crypto": "3.3.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "qrcode-generator": "2.0.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "dependency-cruiser": "18.7.0",
    "fast-check": "4.10.2",
    "jsqr": "1.4.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
